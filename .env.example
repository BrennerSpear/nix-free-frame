# Private settings. Copy/configure to .env; never put real values in this example.
ALBUM_URL="https://photos.google.com/share/REPLACE_WITH_YOUR_SHARED_ALBUM"
FRAME_TOKEN="REPLACE_WITH_GENERATED_PRIVATE_TOKEN"
BIND_ADDRESS="127.0.0.1"
SERVER_PORT="3130"
FRAME_SERVER_URL="http://REPLACE_WITH_PRIVATE_LAN_HOST:3130"
RUNTIME_DIR="runtime"
SLIDESHOW_INTERVAL_SECONDS="15"
NIGHT_START_HOUR="22"
NIGHT_END_HOUR="8"
NIGHT_TIMEZONE="America/New_York"
SYNC_HOUR="9"
SYNC_MINUTE="0"
LAUNCH_AGENT_PREFIX="org.nixfreeframe"
FRAME_SERIAL=""
FRAME_SSH_ADDRESS=""
FRAME_SSH_PORT="8022"
FRAME_SSH_USER=""
FRAME_SSH_ALIAS="nix-frame"
FRAME_SSH_PUBLIC_KEYS_FILE="runtime/ssh/authorized_keys"
FRAME_SSH_PRIVATE_KEY_PATH="runtime/ssh/id_ed25519"
FRAME_SSH_HOST_KEYS_FILE="runtime/ssh/known_hosts"
ANDROID_SDK_ROOT="android/.tools/sdk"
JAVA_HOME="android/.tools/jdk-17.0.20.1+1/Contents/Home"
ADB_PATH="tools/platform-tools/adb"
FRAME_KEYSTORE_PATH="runtime/signing/frame.keystore"
FRAME_KEYSTORE_PASSWORD=""
FRAME_KEY_ALIAS=""
FRAME_KEY_PASSWORD=""
FRAME_BASELINE_APK="runtime/app-installed.apk"
FRAME_INSTALLED_PROOF="runtime/update-installed-proof.json"
